# Maintainer: Bence Szluka <szlukabence@gmail.com>
#
# Source package. Builds the dock from one exact commit of its repository.
#
# The source is pinned to the full commit the release tag points at, not to
# the tag: a tag can be moved or replaced, so a recipe that names one could
# later build different code. The commit is also checksummed — makepkg
# verifies git sources by hashing the tree it checks out — so the same
# recipe can only ever build the same source.
#
# See ../aur-bin/PKGBUILD for the prebuilt variant, which repackages the
# release tarball.

pkgname=omarchy-dock
pkgver=1.2.1
pkgrel=1
# The commit tag v$pkgver points at: `git rev-parse v$pkgver^{commit}`.
_commit=489ec6538184bf8d0b0670c454ddcc9204a81bb7
pkgdesc="A fast, modern dock for Omarchy (Hyprland / Arch), in Rust + GTK4"
arch=('x86_64' 'aarch64')
url="https://github.com/szlukabence/omarchy-dock"
license=('MIT')

# gtk4-layer-shell is the only non-obvious one: it is the C library the dock
# binds to for anchoring, exclusive zones and layer namespaces.
depends=('gtk4' 'gtk4-layer-shell' 'glib2' 'cairo' 'pango' 'gdk-pixbuf2')
makedepends=('cargo')

# Runtime companions. None are hard requirements — without them a feature does
# nothing rather than the dock failing — so they are optional.
optdepends=(
  'omarchy: theme tokens, menu, notifications, and the shell integration'
  'hyprland: window state, workspaces, and dispatching'
  'ttf-jetbrains-mono-nerd: glyphs for the launcher, folder stacks and Trash'
)

# Pacman should auto-remove the prebuilt variant when switching to source.
conflicts=('omarchy-dock-bin')

makedepends+=('git')
# !debug: the release profile carries no symbols, so the split debug package
# would be empty.
options=('!debug')
source=("$pkgname::git+$url.git#commit=$_commit")
sha256sums=('bce0f215aab93c57f698ca96d89cce6362a4a5ec48adac39ca2eabd43650cec3')

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # The magnification spike is a development artefact and is not shipped.
  cargo build --frozen --release --bin omarchy-dock --bin omarchy-dockctl
}

check() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release --bin omarchy-dock --bin omarchy-dockctl
}

package() {
  cd "$pkgname"
  install -Dm0755 "target/release/omarchy-dock" "$pkgdir/usr/bin/omarchy-dock"
  install -Dm0755 "target/release/omarchy-dockctl" "$pkgdir/usr/bin/omarchy-dockctl"
  install -Dm0644 "README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm0644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
